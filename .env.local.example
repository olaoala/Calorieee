# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Free API key for USDA FoodData Central (food search).
# Sign up (instant, no cost): https://fdc.nal.usda.gov/api-key-signup
# Works without this using "DEMO_KEY" but that's rate-limited to ~30 requests/hour/IP.
FDC_API_KEY=your-fdc-api-key

# Open Food Facts requires no API key — nothing to configure.

# Server-only key used by the push-reminders cron route to read across all
# users' data (bypasses RLS by design — never expose to the client).
# Supabase project: Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (background reminder notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the client; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the reminders cron must send as `Authorization: Bearer
# <value>` when it calls /api/push/send-reminders. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your-random-secret
